# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Postgres. For Supabase use the "Session pooler" connection string and the asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Public scraping through Apify actors (no cookies, no login).
APIFY_TOKEN=

# Models. Gemini carries verdicts, extraction and vision; Groq carries most date turns when its free quota allows.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: switch off new pasted runs while the demo stays browsable, and cap live runs per day.
# PASTE_ENABLED=true
# LIVE_RUN_DAILY_CAP=12
